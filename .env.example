# Every VITE_ variable the app reads (validated at startup by src/shared/lib/env.ts; a bad value
# shows the startup error screen). Vite also sets MODE / DEV / PROD itself; no need to set them.

# Backend base URL (axios baseURL): a path on this origin ("/api", default; e.g. behind a reverse
# proxy) or an absolute http(s) URL ("https://api.example.com/api"). Keep "/api" while mocking.
VITE_API_URL=/api

# "true" (default): the in-browser mock API (MSW) answers /api/* and the dev tools are on (demo
# account picker, role switcher, billing simulator, dev data persistence, window.__apex* hooks).
# "false": talk to the real backend at VITE_API_URL; none of the mock or dev-tool code is loaded
# (`npm run build:prod` builds this way and checks the bundle).
VITE_API_MOCK=true

# Not read by the app (tooling only): E2E_PORT picks the Playwright dev-server port (playwright.config.ts).
